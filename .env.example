# ============================================================
# Family Planner Shanghai — Environment Variables
# ============================================================
# ANLEITUNG:
#   cp .env.example .env
#   nano .env   ← alle Werte ausfüllen
#   NIEMALS .env in Git committen!
# ============================================================

# ─── Allgemein ──────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0

# Deine Domain (ohne https://)
# Beispiel: familyplanner.meinedomain.de
DOMAIN=yourdomain.tld

CORS_ORIGINS=https://admin.yourdomain.tld

# ─── Traefik ACME (Let's Encrypt) ───────────────────────────
# E-Mail für SSL-Zertifikat-Benachrichtigungen
# MUSS in infrastructure/traefik/traefik.yml angepasst werden!
# ACME_EMAIL=admin@yourdomain.tld

# ─── JWT (RS256 Asymmetrisch) ───────────────────────────────
# Keys generieren:
#   openssl genrsa -out /tmp/jwt_private.pem 2048
#   openssl rsa -in /tmp/jwt_private.pem -pubout -out /tmp/jwt_public.pem
# Als einzeilige Strings (newlines als \n):
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/jwt_private.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nHIER_DEINEN_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nHIER_DEINEN_PUBLIC_KEY\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ─── Bcrypt / Sicherheit ────────────────────────────────────
BCRYPT_ROUNDS=12
# Zufälliger String (min. 32 Zeichen):
#   openssl rand -base64 32
BCRYPT_PEPPER=HIER_ZUFAELLIGEN_STRING_EINGEBEN

# ─── Datenbank ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=family_planner
DB_USER=family_app
# Sicheres Passwort generieren:
#   openssl rand -base64 24
DB_PASSWORD=HIER_SICHERES_PASSWORT
DB_SSL=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=20

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=HIER_SICHERES_REDIS_PASSWORT
REDIS_DB=0

# ─── MinIO (Datei-Speicher) ──────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=HIER_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=HIER_MINIO_ADMIN_PASSWORT
MINIO_BUCKET_PUBLIC=family-assets
MINIO_BUCKET_VAULT=family-vault
MINIO_BUCKET_BACKUPS=family-backups

# ─── Vault Verschlüsselung ──────────────────────────────────
# KRITISCH: 64 Hex-Zeichen (32 Byte)
# Generieren: openssl rand -hex 32
# WARNUNG: Diesen Key verlieren = alle Vault-Dokumente für immer weg!
# BACKUP im Passwort-Manager!
VAULT_ENCRYPTION_KEY=HIER_64_HEX_ZEICHEN

# ─── Push Notifications (iOS) ───────────────────────────────
# Besorgen unter: https://developer.apple.com/account
# Certificates, Identifiers & Profiles → Keys → "+"
APNS_KEY_ID=DEIN_APNS_KEY_ID
APNS_TEAM_ID=DEIN_APPLE_TEAM_ID
# .p8 Datei Inhalt als einzeiliger String:
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nHIER_APNS_KEY\n-----END PRIVATE KEY-----"
APNS_PRODUCTION=true
APNS_BUNDLE_ID=com.deinname.familyplanner

# ─── Push Notifications (Android, optional) ─────────────────
# Nicht nötig für China-Betrieb — in-app Notifications reichen
# FCM_SERVER_KEY=OPTIONAL

# ─── Wetter-API ─────────────────────────────────────────────
# QWeather (China-nativ, empfohlen für Shanghai):
#   https://dev.qweather.com → Anmelden → API Key erstellen (Free Tier reicht)
QWEATHER_API_KEY=OPTIONAL_QWEATHER_KEY

# OpenWeather (Fallback, falls kein QWeather):
#   https://openweathermap.org/api → Free Tier
OPENWEATHER_API_KEY=OPTIONAL_OPENWEATHER_KEY

# Standard-Koordinaten (Shanghai Puxi)
WEATHER_LAT=31.2304
WEATHER_LON=121.4737

# ─── Swagger API-Dokumentation ──────────────────────────────
# true nur zum Testen, niemals dauerhaft in Produktion!
SWAGGER_ENABLED=false

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Backup ─────────────────────────────────────────────────
# Für automatischen S3-Backup (optional, wenn MinIO genutzt wird)
BACKUP_RETENTION_DAYS=30
