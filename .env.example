# ============================================================
# Family Planner Shanghai — Environment Variables
# ============================================================
# ANLEITUNG:
#   cp .env.example .env
#   nano .env   ← alle Werte ausfüllen (alle HIER_* ersetzen)
#   bash infrastructure/scripts/preflight.sh  ← Pflichtfelder prüfen
#   NIEMALS .env in Git committen!
# ============================================================

# ─── Allgemein ──────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0

# Deine Domain ohne https:// und ohne trailing slash
# Beispiel: familyplanner.meinedomain.de
DOMAIN=HIER_DOMAIN_EINTRAGEN

# CORS: Admin Panel Origin — wird automatisch aus DOMAIN abgeleitet von preflight.sh
# Manuell überschreiben wenn nötig:
CORS_ORIGINS=https://admin.HIER_DOMAIN_EINTRAGEN

# ─── Traefik ACME (Let's Encrypt) ───────────────────────────
# E-Mail für SSL-Zertifikat Ablaufbenachrichtigungen von Let's Encrypt.
# PFLICHTFELD — deploy.sh trägt diesen Wert in traefik.yml ein.
ACME_EMAIL=HIER_EMAIL_EINTRAGEN

# ─── JWT (RS256 Asymmetrisch) ───────────────────────────────
# Keys generieren:
#   openssl genrsa -out /tmp/jwt_private.pem 2048
#   openssl rsa -in /tmp/jwt_private.pem -pubout -out /tmp/jwt_public.pem
# Als einzeilige ENV-Strings (Newlines als \n):
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/jwt_private.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nHIER_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nHIER_PUBLIC_KEY\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ─── Bcrypt / Sicherheit ────────────────────────────────────
BCRYPT_ROUNDS=12
# Generieren: openssl rand -base64 32
BCRYPT_PEPPER=HIER_PEPPER_EINTRAGEN

# ─── Datenbank ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=family_planner
DB_USER=family_app
# Generieren: openssl rand -base64 24
DB_PASSWORD=HIER_DB_PASSWORT
DB_SSL=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=20

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Generieren: openssl rand -base64 24
REDIS_PASSWORD=HIER_REDIS_PASSWORT
REDIS_DB=0

# ─── MinIO (Datei-Speicher) ──────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=HIER_MINIO_USER
# Generieren: openssl rand -base64 24
MINIO_ROOT_PASSWORD=HIER_MINIO_PASSWORT
MINIO_BUCKET_PUBLIC=family-assets
MINIO_BUCKET_VAULT=family-vault
MINIO_BUCKET_BACKUPS=family-backups

# ─── Vault Verschlüsselung ──────────────────────────────────
# KRITISCH: 64 Hex-Zeichen (= 32 Byte AES-256 Key)
# Generieren: openssl rand -hex 32
# WARNUNG: Verlust = alle Vault-Dokumente dauerhaft unlesbar!
# Sofort im Passwort-Manager sichern!
VAULT_ENCRYPTION_KEY=HIER_64_HEX_ZEICHEN

# ─── Push Notifications iOS (optional) ──────────────────────
# Nur nötig wenn iOS Push Notifications gewünscht.
# Besorgen: developer.apple.com → Certificates → Keys → "+"
APNS_KEY_ID=HIER_APNS_KEY_ID
APNS_TEAM_ID=HIER_APPLE_TEAM_ID
# .p8 Datei-Inhalt als einzeiliger String (Newlines als \n):
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nHIER_APNS_KEY\n-----END PRIVATE KEY-----"
APNS_PRODUCTION=true
# Muss mit APP_BUNDLE_ID in EAS übereinstimmen:
APNS_BUNDLE_ID=HIER_BUNDLE_ID

# ─── Push Notifications Android (optional) ──────────────────
# Nicht nötig für China-Betrieb — in-app Notifications reichen
# FCM_SERVER_KEY=OPTIONAL

# ─── Wetter-API (optional) ──────────────────────────────────
# QWeather (China-nativ, empfohlen): https://dev.qweather.com (Free Tier)
QWEATHER_API_KEY=OPTIONAL

# OpenWeather (Fallback): https://openweathermap.org/api (Free Tier)
OPENWEATHER_API_KEY=OPTIONAL

# GPS-Koordinaten (Standard: Shanghai Puxi)
WEATHER_LAT=31.2304
WEATHER_LON=121.4737

# ─── Swagger ────────────────────────────────────────────────
# Nur zum Testen! In Produktion auf false lassen.
SWAGGER_ENABLED=false

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Backup ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
