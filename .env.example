# ============================================================
# Family Planner Shanghai - Environment Variables
# ============================================================
# KOPIERE DIESE DATEI ZU .env UND FÜLLE ALLE WERTE AUS
# COMMITTE NIEMALS DIE .env DATEI!

# ─── App ────────────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0
DOMAIN=yourdomain.tld
PORT=3000
CORS_ORIGINS=https://admin.yourdomain.tld

# ─── JWT (RS256 Asymmetrisch) ───────────────────────────────
# Generieren: openssl genrsa -out private.pem 2048
#             openssl rsa -in private.pem -pubout -out public.pem
# Dann Keys als einzeilige Strings mit \n encoding:
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ─── Bcrypt ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
BCRYPT_PEPPER=GENERATE_A_RANDOM_32_CHAR_STRING_HERE

# ─── Database ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=family_planner
DB_USER=family_app
DB_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
DB_SSL=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=20

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
REDIS_DB=0

# ─── MinIO (S3-kompatibel) ──────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=GENERATE_MINIO_USER_HERE
MINIO_ROOT_PASSWORD=GENERATE_STRONG_MINIO_PASSWORD_HERE
MINIO_BUCKET_PUBLIC=family-assets
MINIO_BUCKET_VAULT=family-vault
MINIO_BUCKET_BACKUPS=family-backups

# ─── Vault Verschlüsselung ──────────────────────────────────
# KRITISCH: 32 Byte Hex-String (64 Zeichen)
# Generieren: openssl rand -hex 32
# WARNUNG: Diesen Key verlieren = Vault-Dateien permanent verloren!
# Backup dieses Keys in einem sicheren Passwort-Manager!
VAULT_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS_HERE

# ─── Push Notifications ─────────────────────────────────────
# APNs (iOS)
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----"
APNS_PRODUCTION=true
APNS_BUNDLE_ID=com.yourname.familyplanner

# FCM (Android) - Optional, China-Fallback aktiv
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# ─── Weather API ────────────────────────────────────────────
WEATHER_API_PROVIDER=openweathermap
WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
WEATHER_DEFAULT_LOCATION=Shanghai,CN

# ─── Google Calendar (Vollständig optional) ─────────────────
# Nur ausfüllen wenn Google Calendar Sync gewünscht
GOOGLE_CALENDAR_CLIENT_ID=optional
GOOGLE_CALENDAR_CLIENT_SECRET=optional

# ─── Swagger ────────────────────────────────────────────────
SWAGGER_ENABLED=false

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
